# Copy this file to .env and fill in your own values. Never commit .env.

# AI: fill in ONE of these. With an OpenAI key, OpenAI is used automatically.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Google (credentials.json from Google Cloud goes in the project folder;
# token.json is created the first time you run: python -m opzy.auth)
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
CALENDAR_ID=primary
# Which emails Opzy is allowed to read. With a personal Gmail, use a "+" alias so it
# ONLY sees demo emails, e.g. to:yourname+talentco@gmail.com
GMAIL_QUERY=in:inbox newer_than:2d -from:me

# Twilio WhatsApp sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Public URL Twilio calls when you reply on WhatsApp (your ngrok or server URL).
# Leave empty to skip signature checking while testing locally.
PUBLIC_BASE_URL=

# App
POLL_SECONDS=30
DB_PATH=opzy.db
